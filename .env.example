# Copier ce fichier vers `.env`. Ne jamais commiter `.env`.

# --- Application ---
APP_ENV=development
DATABASE_PATH=./data/asaci.db
PUBLIC_BASE_URL=http://localhost:8000
RETENTION_DAYS=90
LOG_LEVEL=INFO

# --- Garde-fous du POC (à laisser tels quels) ---
DEMO_MODE=true
INTEGRATIONS_ENABLED=false
INTEGRATION_BASE_URL=
INTEGRATION_API_TOKEN=

# --- Secrets d'accès (valeurs longues et aléatoires en dehors du poste local) ---
ADMIN_API_KEY=demo-admin-key
# Worker -> API : événements de session (X-Agent-Key)
AGENT_INTERNAL_API_KEY=replace-with-a-long-random-value
# Worker -> API : états métier (X-Internal-Key)
INTERNAL_API_KEY=replace-with-a-different-long-random-value

# --- Voix temps réel (worker LiveKit) ---
VOICE_PROVIDER=google
GOOGLE_API_KEY=
GOOGLE_REALTIME_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
GOOGLE_REALTIME_VOICE=Kore
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=coral

# --- LiveKit Cloud ---
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_TOKEN_TTL_SECONDS=300
AGENT_API_BASE_URL=http://localhost:8000

# --- Canal texte et audio du navigateur (OpenAI, optionnel) ---
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral
